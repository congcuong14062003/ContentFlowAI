# Copy to .env and supply random local values. Never use these environments for production.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=
POSTGRES_DB=contentflow
POSTGRES_PORT=55432
# URL-encode special characters in the password.
DATABASE_URL=postgresql://contentflow:REPLACE_ME@127.0.0.1:55432/contentflow?schema=public
REDIS_PORT=56379
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_ME@127.0.0.1:56379
S3_PORT=59000
S3_CONSOLE_PORT=59001
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=contentflow
S3_FORCE_PATH_STYLE=true
VITE_API_BASE_URL=/api/v1
# Production deployment: externally served HTTPS origin.
PUBLIC_WEB_ORIGIN=https://contentflow.example.com
MAIL_MODE=local
# Technical fallback entitlement; per-workspace overrides are provisioned by an operator.
DEFAULT_BRAND_LIMIT=1
DEFAULT_STORAGE_QUOTA_BYTES=104857600
# Optional host port override when another application occupies 3000 (container remains 3000).
API_HOST_PORT=3000
# AI stays disabled until routes, reviewed prices, credentials, policies and wallet funds are provisioned.
AI_ENABLED=false
AI_ROUTING_CONFIG={"providers":[],"models":[]}
AI_TIMEOUT_MS=30000
AI_CREDIT_MICROS_PER_ATOM=1
# AI_SECRET_OPENAI=  (inject securely; use its name in provider.keyEnv, never the secret in JSON)
MAIL_ENCRYPTION_KEY=
# Local mailbox is private on disk, never served by HTTP. SMTP is mandatory in production.
MAIL_LOCAL_DIR=.local/mail
# MAIL_FROM=your-verified-sender@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_CA_FILE=/absolute/path/to/optional-private-ca.pem
# SMTP_USER=
# SMTP_PASSWORD=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
